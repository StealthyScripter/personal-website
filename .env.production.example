# Required. Generate independently with openssl rand -hex 32 and -hex 48.
# The database password is interpolated into a URL. Use hex for new installs.
PORTFOLIO_DB_PASSWORD=
PORTFOLIO_SECURITY_SECRET=

# Fresh deployments use the stable names below and Compose creates both volumes.
# To adopt existing data, set both names to the existing pair and set external
# to true so Compose fails if either volume is missing. Keep the original secrets.
PORTFOLIO_EXTERNAL_VOLUMES=false
PORTFOLIO_POSTGRES_VOLUME=portfolio_postgres_data
PORTFOLIO_MEDIA_VOLUME=portfolio_media_data
