{
  "name": "personal-website-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/cli.ts seed",
    "admin": "tsx --env-file-if-exists=.env src/cli.ts admin",
    "db:local": "tsx scripts/local-db.ts",
    "test:cleanup": "tsx --env-file=.env scripts/cleanup-browser.ts",
    "test": "tsx --test --test-concurrency=1 tests/api.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "@node-rs/argon2": "^2.0.0",
    "fastify": "^5.0.0",
    "file-type": "21.3.4",
    "pg": "^8.0.0",
    "sharp": "0.35.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
