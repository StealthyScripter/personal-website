NODE_ENV=development
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/personal_site
SECURITY_SECRET=replace-with-at-least-32-random-characters
PORT=4000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
SESSION_HOURS=8
# Set only to the exact trusted reverse-proxy IP/CIDR, never blindly trust all.
TRUST_PROXY=
STORAGE_DRIVER=local
MEDIA_DIR=.local/media
# For S3, use a private bucket and IAM role / normal AWS credential chain.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
